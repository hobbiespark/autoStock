<?xml version="1.0" encoding="UTF-8"?>
<!--
  시크릿 로그 마스킹 — 심층 방어 2겹의 "최후 방어선".

  DART 키(crtfc_key), 텔레그램 봇 토큰(URL 경로), 키움 앱키/시크릿/접근토큰(헤더/바디)은
  WebClient 예외 메시지·디버그 로그·스택트레이스를 통해 미처 걸러내지 못한 채 로그로 새어
  나갈 수 있다. 소스 지점 방어(DartClient/TelegramNotifier 등 catch 블록에서
  common.util.SecretMasking 적용)가 1차 방어선이고, 여기 등록한
  config.logging.SecretMaskingConverter가 콘솔/파일에 실제로 찍히기 직전 %msg와 %ex 양쪽에
  적용되는 최종 방어선이다. 운영 로그를 외부(채팅·이슈)에 공유하더라도 키가 그대로
  노출되지 않는다 — 단, 이것은 안전망일 뿐, 원칙은 애초에 키를 로그 문자열에 넣지 않는 것.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />

    <property name="LOG_FILE" value="${LOG_FILE:-${LOG_PATH:-${LOG_TEMP:-${java.io.tmpdir:-/tmp}}}/autostock.log}" />

    <conversionRule conversionWord="mask"
                     converterClass="com.autostock.config.logging.SecretMaskingConverter" />
    <!-- 예외(%ex/%wEx)는 컴포짓 변환어(%mask(...)) 안에 중첩할 수 없어(로그백 파서 제약)
         %ex 자체를 대체하는 별도 변환어로 마스킹한다 — ThrowableMaskingConverter 참고. -->
    <conversionRule conversionWord="maskedEx"
                     converterClass="com.autostock.config.logging.ThrowableMaskingConverter" />

    <!-- Spring Boot 기본 콘솔/파일 패턴(defaults.xml의 CONSOLE_LOG_PATTERN/FILE_LOG_PATTERN)과
         동일한 골격이되, 메시지(%m)는 %mask(...)로 감싸고 예외는 %maskedEx로 대체한 버전이다. -->
    <property name="MASKED_CONSOLE_LOG_PATTERN"
              value="${CONSOLE_LOG_PATTERN:-%clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd HH:mm:ss.SSS}}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %mask(%m)%n%maskedEx}" />
    <property name="MASKED_FILE_LOG_PATTERN"
              value="${FILE_LOG_PATTERN:-%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd HH:mm:ss.SSS}} ${LOG_LEVEL_PATTERN:-%5p} ${PID:- } --- [%t] %-40.40logger{39} : %mask(%m)%n%maskedEx}" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${MASKED_CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET:-default}</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <encoder>
            <pattern>${MASKED_FILE_LOG_PATTERN}</pattern>
            <charset>${FILE_LOG_CHARSET:-default}</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>${LOG_FILE_MAX_SIZE:-10MB}</maxFileSize>
            <maxHistory>${LOG_FILE_MAX_HISTORY:-14}</maxHistory>
            <totalSizeCap>${LOG_FILE_TOTAL_SIZE_CAP:-1GB}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>
</configuration>
