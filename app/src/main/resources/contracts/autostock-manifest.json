{
  "contract_version": "1.1",
  "app_id": "autostock",
  "app_version": "commands-1.1-1",
  "display_name": "autoStock",
  "deployment": "external",
  "supported_contract_versions": ["1.0", "1.1"],
  "aliases": ["주식앱", "주식", "오토스탁"],
  "capabilities": [
    {"id": "health.read", "implemented": true, "enabled": false, "effect": "read", "permission": "owner", "media_types": ["application/json"]},
    {"id": "trading.read", "implemented": false, "enabled": false, "effect": "read", "permission": "owner", "media_types": ["application/json"]},
    {"id": "trading.control", "implemented": false, "enabled": false, "effect": "write", "permission": "owner", "media_types": ["application/json"]}
  ],
  "commands": [
    {"id": "status_view", "name": "운영 상태 보기", "description": "가동 여부, 실행 모드, 긴급 정지 여부, 실시간 시세 연결을 보여 준다", "risk": "query", "keywords": ["상태", "가동", "모드", "status"],
     "examples": ["주식 상태 조회", "주식앱 지금 돌아가?", "자동매매 켜져 있어?"], "effect": "read", "area": "trading.status", "version": 1, "entries": ["platform", "app_bot", "app_fe"]},
    {"id": "today_pnl_view", "name": "오늘 손익 보기", "description": "오늘 실현손익, 오늘 신청 건수, 일일 손실 한도 사용 정도를 보여 준다", "risk": "query", "keywords": ["손익", "오늘", "수익", "pnl"],
     "examples": ["오늘 손익 얼마야", "오늘 주식 수익 알려줘"], "effect": "read", "area": "account.pnl", "version": 1, "entries": ["platform", "app_bot", "app_fe"]},
    {"id": "positions_view", "name": "보유 종목 보기", "description": "보유 종목별 수량, 평균 단가, 현재가, 평가손익, 수익률을 보여 준다", "risk": "query", "keywords": ["보유", "종목", "포지션", "잔고"],
     "examples": ["지금 들고 있는 종목 보여줘", "보유 종목 수익률 어때?"], "effect": "read", "area": "account.positions", "version": 1, "entries": ["platform", "app_bot", "app_fe"]},
    {"id": "events_view", "name": "최근 신호·체결 보기", "description": "최근 신호, 체결, 리스크 판단 이벤트를 최신순으로 최대 100건 보여 준다", "risk": "query", "keywords": ["신호", "체결", "이벤트", "최근"],
     "examples": ["최근 체결 뭐 있었어?", "방금 신호 나온 거 있어?"], "effect": "read", "area": "trading.events", "version": 1, "entries": ["platform", "app_bot", "app_fe"]},
    {"id": "request_history_view", "name": "매매 신청 기록 보기", "description": "최근 며칠(기본 7일, 최대 90일)의 매매 신청과 체결 수량, 처리 상태를 보여 준다", "risk": "query", "keywords": ["기록", "내역", "체결", "신청"],
     "examples": ["이번 주 매매 신청 내역 보여줘", "최근 신청 기록 확인"], "effect": "read", "area": "trading.history", "version": 1, "entries": ["platform", "app_bot", "app_fe"]},
    {"id": "daily_perf_view", "name": "일별 성과 보기", "description": "날짜별 실현손익, 체결 수, 슬리피지, 보수 모드 여부를 보여 준다(최대 90일)", "risk": "query", "keywords": ["성과", "일별", "추이", "슬리피지"],
     "examples": ["최근 일주일 성과 보여줘", "일별 실적 추이 어때?"], "effect": "read", "area": "account.performance", "version": 1, "entries": ["platform", "app_bot", "app_fe"]},
    {"id": "daily_report_view", "name": "일일 리포트 다시 보기", "description": "장 마감 리포트의 핵심(당일 성과와 운영 상태)을 다시 보여 준다", "risk": "query", "keywords": ["리포트", "보고서", "마감", "요약"],
     "examples": ["오늘 마감 리포트 다시 보여줘", "일일 보고서 요약해줘"], "effect": "read", "area": "account.report", "version": 1, "entries": ["platform", "app_bot", "app_fe"]},
    {"id": "decisions_view", "name": "전략 판단 기록 보기", "description": "지정한 날짜(기본 오늘)의 종목별 전략 판단 결론과 이유, 지표를 보여 준다", "risk": "query", "keywords": ["판단", "전략", "이유", "왜"],
     "examples": ["오늘 왜 안 샀어?", "2026-11-05 전략 판단 보여줘"],
     "args": [{"name": "date", "type": "date", "required": false, "description": "판단 날짜(없으면 오늘)", "example": "2026-11-05"}],
     "effect": "read", "area": "trading.decisions", "version": 2, "entries": ["platform", "app_bot", "app_fe"]},
    {"id": "killswitch_view", "name": "긴급 정지 상태 보기", "description": "긴급 정지(킬스위치)가 걸려 있는지 보여 준다", "risk": "query", "keywords": ["킬스위치", "긴급", "정지"],
     "examples": ["긴급 정지 걸려 있어?", "킬스위치 상태 확인"], "effect": "read", "area": "trading.killswitch", "version": 1, "entries": ["platform", "app_bot", "app_fe"]},
    {"id": "quote_view", "name": "종목 시세 보기", "description": "종목 코드 하나의 현재가, 시가, 고가, 저가, 최우선 호가를 보여 준다", "risk": "query", "keywords": ["시세", "현재가", "호가", "가격"],
     "examples": ["005930 지금 얼마야", "005930 시세 알려줘"],
     "args": [{"name": "stock", "type": "stock_code", "required": true, "description": "종목 코드 6자리", "example": "005930"}],
     "effect": "read", "area": "market.quote", "version": 2, "entries": ["platform", "app_bot", "app_fe"]},
    {"id": "ipo_view", "name": "공모주 일정 보기", "description": "공모주 청약 일정과 공모가, 상태를 보여 준다", "risk": "query", "keywords": ["공모주", "청약", "ipo", "상장"],
     "examples": ["이번 주 공모주 청약 일정 알려줘", "청약할 공모주 있어?"], "effect": "read", "area": "ipo.schedule", "version": 1, "entries": ["platform", "app_bot", "app_fe"]},
    {"id": "emergency_stop", "name": "긴급 정지", "description": "새 신청을 즉시 막는다. 안전 쪽 변경이며 텔레그램 /stop 지름길도 그대로 둔다", "risk": "change", "keywords": ["멈춰", "stop", "긴급"],
     "examples": ["주식 자동매매 당장 멈춰", "긴급 정지 걸어줘"], "effect": "write", "area": "trading.killswitch", "version": 1, "entries": ["platform", "app_bot"]},
    {"id": "trading_resume", "name": "긴급 정지 풀기", "description": "긴급 정지를 푼다. autoStock의 60초 4자리 확인 코드 절차를 그대로 거친다", "risk": "l1_ceiling", "keywords": ["다시 시작", "resume"],
     "examples": ["긴급 정지 풀어줘", "자동매매 다시 켜줘"],
     "args": [{"name": "code", "type": "string", "required": false, "description": "두 번째 보낼 때 받은 4자리 확인 코드", "example": "1234"}],
     "effect": "write", "area": "trading.killswitch", "version": 2, "entries": ["platform", "app_bot"]}
  ],
  "notifications": {"self_send": true, "channel": "telegram"}
}
