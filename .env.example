# autoStock 환경변수 카탈로그 (커밋 대상 — 값은 비워둔다)
# 사용법: 이 파일을 복사해 .env로 만들고 실제 값을 채운다. .env 자체는 .gitignore에 의해 커밋되지 않는다.
#   cp .env.example .env
#
# 키움 키 네이밍 규칙 (PROGRESS 5절):
#   - paper(모의) 프로필: KIWOOM_MOCK_G_* 사용. 구명 KIWOOM_APP_KEY/SECRET도 하위호환 폴백으로 인식되지만
#     신규로는 KIWOOM_MOCK_G_*를 쓸 것.
#   - live(실전) 프로필: KIWOOM_LIVE_* 전용. 모의 키로의 폴백은 없음 — 미설정 시 기동 실패가 의도된 동작.

# ── 키움증권 REST API — 모의투자 일반계좌 (paper 프로필, 기본) ─────────────────
# 발급처: https://openapi.kiwoom.com (모의투자 신청) — kiwoom.rest-base-url=https://mockapi.kiwoom.com
# 용도: 모의 무인 운영(RUNBOOK, 게이트 ②), CI 스모크 테스트(KiwoomSmokeIT)
KIWOOM_MOCK_G_APP_KEY=
KIWOOM_MOCK_G_APP_SECRET=

# ── 키움증권 REST API — 실전투자 (live 프로필) ──────────────────────────────
# 발급처: https://openapi.kiwoom.com (실전투자 신청, 계좌 연동) — kiwoom.rest-base-url=https://api.kiwoom.com
# ⚠️ 비워둘 것 — 게이트 ② 통과 + 키 재발급 전까지 절대 값을 채우지 않는다 (PROGRESS 5절, PLAN 1절)
KIWOOM_LIVE_APP_KEY=
KIWOOM_LIVE_APP_SECRET=

# ── OpenDART (공시·재무제표) ────────────────────────────────────────────────
# 발급처: https://opendart.fss.or.kr (API 인증키 신청)
# 용도: dart.api-key, ipo.blacklist.dart-api-key(같은 키 재사용) — dart.enabled=true / ipo.blacklist.enabled=true 필요
DART_API_KEY=

# ── 텔레그램 봇 (알림 + 원격 킬스위치) ──────────────────────────────────────
# 발급처: BotFather(@BotFather)에서 봇 생성 → 토큰 발급, 본인 chat_id는 봇과 대화 후 getUpdates로 확인
# 활성화 조건: monitor.telegram.enabled=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── FRED (세인트루이스 연준 경제지표, VIX 등) ───────────────────────────────
# 발급처: https://fred.stlouisfed.org (API key 신청)
# 활성화 조건: macrointel.enabled=true
FRED_API_KEY=

# ── ECOS (한국은행 경제통계, 환율·기준금리) ─────────────────────────────────
# 발급처: https://ecos.bok.or.kr (Open API 인증키 신청)
# 활성화 조건: macrointel.enabled=true
ECOS_API_KEY=

# ── 공공데이터포털 (특일 정보, 휴장일) ──────────────────────────────────────
# 발급처: https://www.data.go.kr (특일 정보 서비스 활용신청, 자동승인)
# 활성화 조건: market.holiday-api.enabled=true
DATA_GO_KR_SERVICE_KEY=
